---
import type { Profile } from "../../data/profile";
import type { Ui } from "../../i18n/ui";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  p: Profile;
  t: Ui;
}

const { p, t } = Astro.props;
---

<section id="about" class="border-t border-line py-16 md:py-24">
  <SectionHeading index="01" title={t.nav.about} />
  <div class="max-w-prose space-y-5 leading-relaxed text-muted" data-reveal>
    {p.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
