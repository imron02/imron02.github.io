---
import type { Profile } from "../../data/profile";
import type { Ui } from "../../i18n/ui";
import SectionHeading from "../SectionHeading.astro";
import SocialLinks from "../SocialLinks.astro";

interface Props {
  p: Profile;
  t: Ui;
}

const { p, t } = Astro.props;
---

<section id="contact" class="border-t border-line py-16 md:py-24">
  <SectionHeading index="05" title={t.nav.contact} />
  <p class="max-w-prose leading-relaxed text-muted" data-reveal>{p.contactIntro}</p>
  <a
    href={`mailto:${p.email}`}
    class="mt-6 inline-block font-mono text-xl text-ink underline decoration-line underline-offset-8 transition-colors hover:text-accent hover:decoration-accent md:text-2xl"
    data-reveal
  >
    {p.email}
  </a>
  <div class="mt-10" data-reveal>
    <SocialLinks socials={p.socials} showLabels />
  </div>
</section>
