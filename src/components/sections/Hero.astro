---
import { ArrowRight, Download } from "lucide-react";
import type { Profile } from "../../data/profile";
import type { Ui } from "../../i18n/ui";
import SocialLinks from "../SocialLinks.astro";

interface Props {
  p: Profile;
  t: Ui;
}

const { p, t } = Astro.props;
---

<section id="top" class="flex min-h-svh flex-col justify-center py-24">
  <p class="font-mono text-sm text-accent" data-reveal>{p.greeting}</p>
  <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink md:text-6xl" data-reveal>
    {p.name}
  </h1>
  <p class="mt-3 text-lg text-ink md:text-xl" data-reveal>{p.role} · {p.location}</p>
  <p class="mt-5 max-w-prose leading-relaxed text-muted" data-reveal>{p.tagline}</p>
  <p class="mt-5 flex items-center gap-2 text-sm text-muted" data-reveal>
    <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
    {p.availability}
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-4" data-no-print data-reveal>
    <button
      type="button"
      data-print-cv
      class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-85"
    >
      <Download className="size-4" />
      {t.actions.downloadCv}
    </button>
    <a
      href="#projects"
      class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-sm text-ink transition-colors hover:border-accent hover:text-accent"
    >
      {t.actions.viewProjects}
      <ArrowRight className="size-4" />
    </a>
  </div>
  <div class="mt-10" data-reveal>
    <SocialLinks socials={p.socials} />
  </div>
</section>
