---
import type { Profile } from "../../data/profile";
import type { Ui } from "../../i18n/ui";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  p: Profile;
  t: Ui;
}

const { p, t } = Astro.props;
---

<section id="experience" class="border-t border-line py-16 md:py-24">
  <SectionHeading index="03" title={t.nav.experience} />
  <ol class="space-y-12 border-s border-line ps-6">
    {
      p.experience.map((job) => (
        <li class="relative" data-reveal>
          <span
            class="absolute -start-[29px] top-1.5 size-2.5 rounded-full bg-accent ring-4 ring-canvas"
            aria-hidden="true"
          />
          <p class="font-mono text-xs text-muted">{job.period}</p>
          <h3 class="mt-1 text-base font-medium text-ink">
            {job.role} — <span class="text-muted">{job.company}</span>
          </h3>
          <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted">{job.summary}</p>
          <ul class="mt-3 list-disc space-y-1 ps-5 text-sm text-muted">
            {job.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
