---
import { Menu, X } from "lucide-react";
import { localeHref, otherLocale } from "../i18n/config";
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";
import { profile } from "../data/profile";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const links = [
  { href: "#about", label: t.nav.about },
  { href: "#skills", label: t.nav.skills },
  { href: "#experience", label: t.nav.experience },
  { href: "#projects", label: t.nav.projects },
  { href: "#contact", label: t.nav.contact },
];
---

<header data-no-print class="sticky top-0 z-40 border-b border-line bg-canvas/80 backdrop-blur">
  <div class="relative mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-mono text-sm font-medium text-ink hover:text-accent">
      {profile[locale].name.toLowerCase()}<span class="text-accent">.dev</span>
    </a>
    <nav
      data-nav
      id="site-nav"
      class="items-center gap-6 md:flex-row"
      aria-label={t.a11y.navToggle}
    >
      {
        links.map((link) => (
          <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
            {link.label}
          </a>
        ))
      }
      <a
        href={localeHref(otherLocale(locale))}
        class="font-mono text-sm text-accent hover:opacity-80"
        aria-label={t.a11y.langSwitch}
      >
        {otherLocale(locale).toUpperCase()}
      </a>
    </nav>
    <button
      data-nav-toggle
      type="button"
      class="text-muted transition-colors hover:text-ink md:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t.a11y.navToggle}
    >
      <Menu data-icon="menu" className="size-5" />
      <X data-icon="x" className="size-5" />
    </button>
  </div>
</header>
