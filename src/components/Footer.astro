---
import { profile } from "../data/profile";
import { ui } from "../i18n/ui";
import type { Locale } from "../i18n/config";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = profile[locale];
---

<footer data-no-print class="border-t border-line py-10">
  <div class="mx-auto flex max-w-3xl flex-col gap-6 px-6 md:flex-row md:items-center md:justify-between">
    <SocialLinks socials={p.socials} />
    <div class="flex flex-col gap-1 text-xs text-muted md:items-end">
      <p>© {new Date().getFullYear()} {p.name}</p>
      <p>{ui[locale].footer.built}</p>
    </div>
  </div>
</footer>
