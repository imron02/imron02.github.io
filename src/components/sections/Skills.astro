---
import type { Profile } from "../../data/profile";
import type { Ui } from "../../i18n/ui";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  p: Profile;
  t: Ui;
}

const { p, t } = Astro.props;
---

<section id="skills" class="border-t border-line py-16 md:py-24">
  <SectionHeading index="02" title={t.nav.skills} />
  <div class="grid gap-8 sm:grid-cols-2">
    {
      p.skillGroups.map((group) => (
        <div data-reveal>
          <h3 class="mb-3 text-sm font-medium text-ink">{group.title}</h3>
          <ul class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
