---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/orbitron";
import "../styles/global.css";
import { MOBILE_QUERY, worldAssetUrls } from "../lib/worldAssets";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Imron Rosdiana — Anime RPG Portfolio",
  description = "An anime-RPG portfolio world for Imron Rosdiana — senior frontend engineer crafting modern web and mobile experiences.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const warmProbe = JSON.stringify({
  mobileQuery: MOBILE_QUERY,
  desktop: worldAssetUrls(base, false),
  mobile: worldAssetUrls(base, true),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#080B25" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <title>{title}</title>
    <noscript>
      <style is:inline>#loading-screen{display:none!important}</style>
    </noscript>
    <script is:inline data-warm-probe={warmProbe}>
      (function () {
        var cfg;
        try {
          cfg = JSON.parse(
            document.currentScript.getAttribute("data-warm-probe"),
          );
        } catch (e) {
          return;
        }
        var targets = window.matchMedia(cfg.mobileQuery).matches
          ? cfg.mobile
          : cfg.desktop;
        window.__worldWarmProbe = Promise.all(
          targets.map(function (url) {
            return fetch(url, { cache: "only-if-cached", mode: "same-origin" })
              .then(function (res) {
                return res.ok || res.type === "opaque";
              })
              .catch(function () {
                return false;
              });
          }),
        ).then(function (flags) {
          var warm = flags.length > 0 && flags.every(Boolean);
          if (warm) document.documentElement.setAttribute("data-world-warm", "");
          return warm;
        });
      })();
    </script>
    <style is:inline>
      html[data-world-warm] #loading-screen {
        display: none;
      }
    </style>
  </head>
  <body>
    <main class="relative h-dvh overflow-hidden bg-void"><slot /></main>
  </body>
</html>