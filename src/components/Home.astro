---
import Layout from "../layouts/Layout.astro";
import Hero from "./sections/Hero.astro";
import About from "./sections/About.astro";
import Skills from "./sections/Skills.astro";
import Experience from "./sections/Experience.astro";
import Projects from "./sections/Projects.astro";
import Contact from "./sections/Contact.astro";
import { profile } from "../data/profile";
import { ui } from "../i18n/ui";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = profile[locale];
const t = ui[locale];
---

<Layout locale={locale} title={t.meta.title} description={t.meta.description}>
  <main id="main" class="mx-auto max-w-3xl px-6">
    <Hero p={p} t={t} />
    <About p={p} t={t} />
    <Skills p={p} t={t} />
    <Experience p={p} t={t} />
    <Projects p={p} t={t} />
    <Contact p={p} t={t} />
  </main>
</Layout>
