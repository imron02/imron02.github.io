---
const base = import.meta.env.BASE_URL;

type Petal = {
  x: number;
  y: number;
  w: number;
  h: number;
  opacity: number;
  rotation?: number;
};

// Coordinates mirror frame `qlSqT` (1920x1080) of design/CV-Game.pen.
const desktopPetals: Petal[] = [
  { x: 118, y: 214, w: 10, h: 6.2, opacity: 0.55, rotation: 25 },
  { x: 286, y: 428, w: 7, h: 4.34, opacity: 0.4, rotation: -40 },
  { x: 452, y: 162, w: 12, h: 7.44, opacity: 0.6, rotation: 60 },
  { x: 868, y: 196, w: 8, h: 4.96, opacity: 0.35, rotation: 15 },
  { x: 1178, y: 338, w: 10, h: 6.2, opacity: 0.45, rotation: -30 },
  { x: 1252, y: 566, w: 7, h: 4.34, opacity: 0.35, rotation: 80 },
  { x: 164, y: 752, w: 9, h: 5.58, opacity: 0.45, rotation: -55 },
  { x: 986, y: 706, w: 7, h: 4.34, opacity: 0.3, rotation: 35 },
  { x: 1446, y: 252, w: 9, h: 5.58, opacity: 0.35, rotation: -20 },
  { x: 1758, y: 432, w: 11, h: 6.82, opacity: 0.4, rotation: 45 },
  { x: 1698, y: 672, w: 7, h: 4.34, opacity: 0.3, rotation: -65 },
  { x: 1338, y: 868, w: 9, h: 5.58, opacity: 0.3, rotation: 20 },
  { x: 706, y: 956, w: 8, h: 4.96, opacity: 0.35, rotation: 55 },
  { x: 198, y: 588, w: 6, h: 3.72, opacity: 0.35, rotation: -25 },
  { x: 884, y: 470, w: 7, h: 4.34, opacity: 0.3, rotation: 70 },
  { x: 1548, y: 742, w: 6, h: 3.72, opacity: 0.3, rotation: -40 },
];

// Coordinates mirror frame `NG14P` (430x932).
const mobilePetals: Petal[] = [
  { x: 58, y: 196, w: 7, h: 4.3, opacity: 0.85 },
  { x: 356, y: 224, w: 5, h: 3.1, opacity: 0.85 },
  { x: 92, y: 300, w: 9, h: 5.6, opacity: 0.85 },
  { x: 300, y: 342, w: 6, h: 3.7, opacity: 0.85 },
  { x: 28, y: 392, w: 5, h: 3.1, opacity: 0.85 },
  { x: 386, y: 150, w: 6, h: 3.7, opacity: 0.85 },
  { x: 152, y: 132, w: 4, h: 2.5, opacity: 0.85 },
];

const petalStyle = (petal: Petal, frameWidth: number, frameHeight: number) => {
  const pct = (value: number, total: number) => `${(value / total) * 100}%`;
  return [
    `--x:${pct(petal.x, frameWidth)}`,
    `--y:${pct(petal.y, frameHeight)}`,
    `--w:${pct(petal.w, frameWidth)}`,
    `--h:${pct(petal.h, frameHeight)}`,
    `--o:${petal.opacity}`,
    petal.rotation === undefined ? null : `--rot:${petal.rotation}deg`,
  ]
    .filter(Boolean)
    .join(";");
};
---

<div
  class="absolute inset-0 overflow-hidden pointer-events-none"
  aria-hidden="true"
>
  <img
    class="absolute z-0 inset-0 block h-full w-full object-cover object-center"
    src={`${base}images/world-bg.webp`}
    alt=""
    width="1376"
    height="768"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />

  <span
    class="absolute pointer-events-none z-[1] left-[9.375%] top-[38.889%] w-[52.083%] h-[61.111%] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-primary-dark)_24%,transparent),color-mix(in_srgb,var(--color-secondary)_10%,transparent)_55%,transparent_100%)] opacity-50 blur-[60px] mobile:z-[2] mobile:left-[-6.977%] mobile:top-[20.386%] mobile:w-[109.302%] mobile:h-[55.794%] mobile:opacity-100 mobile:blur-[40px]"
  ></span>
  <span
    class="absolute pointer-events-none z-[2] left-0 top-[64.815%] w-full h-[18.519%] bg-[linear-gradient(90deg,transparent_0%,color-mix(in_srgb,var(--color-secondary)_18%,transparent)_55%,transparent_100%)] opacity-35 blur-[60px] mobile:z-[3] mobile:top-[48.498%] mobile:h-[16.094%] mobile:opacity-100 mobile:blur-none"
  ></span>
  <span
    class="absolute pointer-events-none z-[3] left-[29.167%] top-[25%] w-[34.375%] h-[64.815%] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-primary)_20%,transparent),transparent_75%)] opacity-70 mobile:z-[4] mobile:left-[5.116%] mobile:top-[11.159%] mobile:w-[89.767%] mobile:h-[36.481%] mobile:opacity-100"
  ></span>
  <span
    class="absolute pointer-events-none z-[4] left-[36.458%] top-[74.444%] w-[17.708%] h-[2.963%] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-void)_85%,transparent),transparent_100%)] opacity-55 blur-[8px] mobile:hidden"
  ></span>

  <div
    class="absolute z-[5] left-[35.3125%] top-[36.296%] h-[63.611%] w-[22.552%] mobile:left-[9.302%] mobile:top-[13.734%] mobile:h-[32.189%] mobile:w-[81.395%]"
  >
    <picture class="contents">
      <source
        media="(max-width: 1023px)"
        srcset={`${base}images/character-mobile.webp`}
      />
      <img
        class="block h-full w-full object-cover mobile:object-contain mobile:object-right"
        src={`${base}images/character.webp`}
        alt=""
        width="467"
        height="740"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  {desktopPetals.map((petal, index) => (
    <span
      class={`absolute pointer-events-none z-[6] left-[var(--x)] top-[var(--y)] h-[var(--h)] w-[var(--w)] rounded-full bg-accent-pink opacity-[var(--o)] [transform:rotate(var(--rot,0deg))] mobile:hidden ${index % 2 === 0 ? "motion-safe:animate-petal-float-long" : "motion-safe:animate-petal-float"}`}
      style={petalStyle(petal, 1920, 1080)}
    />
  ))}

  {mobilePetals.map((petal, index) => (
    <span
      class={`absolute pointer-events-none z-[6] left-[var(--x)] top-[var(--y)] h-[var(--h)] w-[var(--w)] rounded-full bg-accent-pink opacity-[var(--o)] [transform:rotate(var(--rot,0deg))] hidden mobile:block ${index % 2 === 0 ? "motion-safe:animate-petal-float-long" : "motion-safe:animate-petal-float"}`}
      style={petalStyle(petal, 430, 932)}
    />
  ))}

  <span
    class="absolute pointer-events-none z-[7] left-0 top-0 h-full w-[52.083%] bg-[linear-gradient(270deg,transparent_0%,color-mix(in_srgb,var(--color-void)_30%,transparent)_50%,color-mix(in_srgb,var(--color-void)_70%,transparent)_100%)] mobile:hidden"
  ></span>
  <span
    class="absolute pointer-events-none left-[61.458%] top-0 h-full w-[38.542%] bg-[linear-gradient(90deg,transparent_0%,color-mix(in_srgb,var(--color-void)_60%,transparent)_45%,color-mix(in_srgb,var(--color-void)_92%,transparent)_100%)] mobile:hidden"
  ></span>
  <span
    class="absolute pointer-events-none left-0 top-0 h-[18.519%] w-full bg-[linear-gradient(0deg,transparent_0%,color-mix(in_srgb,var(--color-void)_65%,transparent)_100%)] mobile:z-[1] mobile:h-[24.678%] mobile:bg-[linear-gradient(0deg,transparent_0%,color-mix(in_srgb,var(--color-void)_45%,transparent)_55%,color-mix(in_srgb,var(--color-void)_75%,transparent)_100%)]"
  ></span>
  <span
    class="absolute pointer-events-none left-0 top-[76.852%] h-[23.148%] w-full bg-[linear-gradient(180deg,transparent_0%,color-mix(in_srgb,var(--color-void)_70%,transparent)_70%,color-mix(in_srgb,var(--color-void)_88%,transparent)_100%)] mobile:z-[1] mobile:top-[32.189%] mobile:h-[67.811%] mobile:bg-[linear-gradient(180deg,transparent_0%,color-mix(in_srgb,var(--color-void)_35%,transparent)_22%,color-mix(in_srgb,var(--color-void)_68%,transparent)_42%,color-mix(in_srgb,var(--color-void)_90%,transparent)_62%,color-mix(in_srgb,var(--color-void)_97%,transparent)_80%,color-mix(in_srgb,var(--color-void)_98%,transparent)_100%)]"
  ></span>
</div>