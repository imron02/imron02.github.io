{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "biome": {
      "command": ["./node_modules/.bin/biome", "format", "--write", "$FILE"],
      "extensions": [".ts", ".tsx", ".css", ".astro", ".mjs"]
    }
  },
  "watcher": {
    "ignore": ["dist/**", ".astro/**", "design/**", ".omp/**"]
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm publish*", "effect": "deny" }
  ]
}