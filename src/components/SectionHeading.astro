---
interface Props {
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<div class="mb-10 flex items-baseline gap-4" data-reveal>
  <span class="font-mono text-sm text-accent">{index}</span>
  <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">{title}</h2>
</div>
